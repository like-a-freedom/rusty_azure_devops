{
  "$defs": {
    "ProjectDto": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "StatusConfigDto": {
      "properties": {
        "ado_base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "ado_default_project": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_present": {
          "type": "boolean"
        }
      },
      "required": [
        "token_present"
      ],
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "config": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusConfigDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "default_project": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/ProjectDto"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "project_count",
    "projects"
  ],
  "title": "StatusResult",
  "type": "object"
}